{% assign impact = site.data.scholar_impact %}
<div class="home-impact" aria-label="Visitor map and Google Scholar impact">
  <section class="impact-card visitor-map-card" aria-labelledby="visitor-map-heading">
    <h3 id="visitor-map-heading">Visitor Map</h3>
    <div class="visitor-map-widget">
      <script id="_wauc41">
        var _wau = window._wau || [];
        _wau.push(['map', 'spxsvwagk0', 'c41', '420', '240', 'classic', 'cross-pink']);
      </script>
      <script async src="https://waust.at/m.js"></script>
      <noscript><a href="https://whos.amung.us/stats/spxsvwagk0/" target="_blank" rel="noopener noreferrer">View visitor map</a></noscript>
    </div>
    <a class="impact-action" href="https://whos.amung.us/stats/spxsvwagk0/" target="_blank" rel="noopener noreferrer">View visitor stats</a>
  </section>

  <section class="impact-card scholar-impact-card" aria-labelledby="scholar-impact-heading">
    <h3 id="scholar-impact-heading">Google Scholar Impact</h3>
    <div class="scholar-impact-panel">
      <div class="scholar-impact-updated">
        <span>Last verified</span>
        <time datetime="{{ impact.summary.updated }}">{{ impact.summary.updated | date: '%b %d, %Y' }}</time>
      </div>
      <div class="scholar-impact-total">
        <strong>{{ impact.summary.total_citations }}</strong>
        <span>Total citations</span>
      </div>
      <div class="scholar-impact-stats">
        <div>
          <strong>{{ impact.summary.h_index }}</strong><span>h-index</span>
        </div>
        <div>
          <strong>{{ impact.summary.i10_index }}</strong><span>i10-index</span>
        </div>
        <div>
          <strong>{{ impact.summary.paper_count }}</strong><span>Indexed papers</span>
        </div>
      </div>
      <svg class="scholar-impact-chart" viewBox="0 0 300 70" preserveAspectRatio="none" role="img" aria-label="Citation history from daily snapshots">
        <polyline points="{{ impact.chart_points }}"></polyline>
      </svg>
      <a class="scholar-top-paper" href="{{ impact.top_paper.url | escape }}" target="_blank" rel="noopener noreferrer">
        <span>Top cited paper · {{ impact.top_paper.citations }} citations</span>
        <strong>{{ impact.top_paper.title | escape }}</strong>
      </a>
      <div class="scholar-impact-actions">
        <a href="{{ impact.profile.scholar_url | escape }}" target="_blank" rel="noopener noreferrer">Google Scholar</a>
        <a href="{{ '/assets/data/scholar_impact.json' | relative_url }}" target="_blank" rel="noopener noreferrer">Citation JSON</a>
      </div>
    </div>
  </section>
</div>
